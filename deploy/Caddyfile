# HTTPS is automatic (Let's Encrypt). Replace the domain.
api.comi.vn {
	encode gzip
	reverse_proxy api1:3100 api2:3100 {
		# Socket.IO long-polling needs the same instance for one client.
		lb_policy cookie comi_lb
		health_uri /api/v1/health
		health_interval 10s
		fail_duration 30s
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Admin website (Flutter web): `flutter build web --dart-define=API_URL=https://api.comi.vn` in admin_app,
# then copy admin_app/build/web to deploy/admin-web on the server. Optionally limit by IP (remote_ip matcher).
admin.comi.vn {
	encode gzip
	root * /srv/admin
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
